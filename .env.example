APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://locahost
SANCTUM_STATEFUL_DOMAINS="localhost:50529, localhost:35205"
SESSION_DOMAIN=localhost

ENABLE_LOGIN_RSA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

FIRST_USER_FIRST_NAME="Super"
FIRST_USER_MIDDLE_NAME=""
FIRST_USER_LAST_NAME="Admin"
FIRST_USER_EMAIL="admin@admin.com"
FIRST_USER_PASSWORD="password"

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=365
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

MIMES="jpeg,png,pdf"
MAX_FILE_COUNT=5
MAX_FILE_SIZE=2048

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=cache_prefix

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret_redis
REDIS_PORT=6379
REDIS_PREFIX=redis_prefix

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterkey
SCOUT_PREFIX=scout_prefix
SCOUT_QUEUE=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DIGITALOCEAN_SPACES_KEY=digital_ocean_spaces_key_here
DIGITALOCEAN_SPACES_SECRET=digital_ocean_spaaces_secret_key_here
DIGITALOCEAN_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com/
DIGITALOCEAN_SPACES_REGION=sgp1
DIGITALOCEAN_SPACES_BUCKET=bucket-name-here
DIGITALOCEAN_SPACES_PATH=https://bucket-name-here.sgp1.digitaloceanspaces.com/
DIGITALOCEAN_SPACES_ROOT_PATH=project-directory-here/uploads
DIGITALOCEAN_SPACES_EXPIRATION=30

AZURE_STORAGE_NAME=your_storage_account_name
AZURE_STORAGE_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER=your_container_name
AZURE_STORAGE_URL=https://your_storage_account_name.blob.core.windows.net
AZURE_SAS_TOKEN=sv=2025-01-01&ss=b&srt=o&sp=rwlc&se=2025-12-31T23:59:59Z&sig=xxxxxxxxsampleformat
